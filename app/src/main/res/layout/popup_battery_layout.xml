<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#E61A263B">

    <TextView
        android:id="@+id/notification_device_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tai nghe Bluetooth"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="#B8293C55">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L"
                android:textColor="#FF79D9FF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRÁI"
                android:textColor="#FFB9C9DC"
                android:textSize="9sp"
                android:paddingTop="3dp" />

            <TextView
                android:id="@+id/notification_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="3dp" />
        </LinearLayout>

        <View
            android:layout_width="5dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="#B8293C55">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▱"
                android:textColor="#FF79D9FF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HỘP SẠC"
                android:textColor="#FFB9C9DC"
                android:textSize="9sp"
                android:paddingTop="3dp" />

            <TextView
                android:id="@+id/notification_case"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="3dp" />
        </LinearLayout>

        <View
            android:layout_width="5dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="#B8293C55">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R"
                android:textColor="#FF79D9FF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHẢI"
                android:textColor="#FFB9C9DC"
                android:textSize="9sp"
                android:paddingTop="3dp" />

            <TextView
                android:id="@+id/notification_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/notification_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đang chờ dữ liệu pin"
        android:textColor="#FF79E6BC"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="12dp" />

</LinearLayout>
